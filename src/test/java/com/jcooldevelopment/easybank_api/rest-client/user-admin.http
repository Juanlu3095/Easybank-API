### Creates a new user
POST http://localhost:8080/api/admin/user
Content-Type: application/json
Authorization: Bearer eyJhbGciOiJIUzI1NiJ9.eyJzdWIiOiJpSzUxcnJKcEFLIiwiaWF0IjoxNzkwODkzNDc3LCJleHAiOjE3OTA4OTUyNzd9.u4ryTwYcw3gv-hHXAkQ80wXKtqHLXh9UkS7JIFIoEPk

{
  "name": "Pepe",
  "surname": "González",
  "dni": "87528222C",
  "email": "user@example.com",
  "phone": "666786655",
  "password": "nuevacontrasena",
  "repeatPassword": "nuevacontrasena",
  "role": "CLIENT",
  "status": "ENABLED"
}

